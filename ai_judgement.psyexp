        <Param val="trial_data = [[&quot;photos/Miku.jpg&quot;, &quot;a miku&quot;, true], [&quot;photos/crow.png&quot;, &quot;a crow&quot;, true], [&quot;photos/deer.png&quot;, &quot;a zebra&quot;, false], [&quot;photos/red_panda.jpg&quot;, &quot;a bear&quot;, false]];&amp;#10;num_trials = trial_data.length;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
